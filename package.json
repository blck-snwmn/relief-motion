{
  "name": "relief-motion",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun run generate-manifest && bun build ./index.html --outdir dist",
    "generate-depth": "bun run scripts/generate-depth.ts",
    "generate-manifest": "bun run scripts/generate-manifest.ts",
    "screenshot": "bun run scripts/screenshot.ts",
    "inpaint": "bun run scripts/inpaint.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "1.61.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  }
}
